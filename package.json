{
  "name": "latest-template",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "lint": "eslint App.jsx index.js jest.setup.js eslint.config.js src modules --max-warnings=0",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "modules/*/src/**/*.{js,jsx}",
      "!**/*.test.{js,jsx}",
      "!**/__tests__/**"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80,
        "branches": 69.46,
        "functions": 80.08
      }
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-modules-core": "~3.0.30",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "globals": "^17.7.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0"
  }
}
