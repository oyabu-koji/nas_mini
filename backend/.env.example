MEDIA_ROOT=/private/tmp/mediavault-media
API_TOKEN=replace-with-local-development-token
DATABASE_PATH=/private/tmp/mediavault-backend.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
JOB_LEASE_SECONDS=300
LUT_PATH=/app/assets/lut/rec709.cube
# Set USER_LUT_ROOT=/user_luts and point USER_LUT_ROOT_HOST_PATH at the host registry.
USER_LUT_ROOT=
USER_LUT_ROOT_HOST_PATH=/private/tmp/mediavault-user-luts
